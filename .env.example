# SecPlat environment — copy this file to `.env` before starting the stack:
#
#   cp .env.example .env
#   docker compose up -d --build
#
# The defaults below work out of the box for a local evaluation.
# CHANGE EVERY VALUE MARKED "change-me" BEFORE ANY SHARED OR PRODUCTION DEPLOYMENT.

# ── Postgres ────────────────────────────────────────────────
POSTGRES_DB=secplat
POSTGRES_USER=secplat
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5433

# ── OpenSearch ──────────────────────────────────────────────
OPENSEARCH_HEAP=512m
# Must satisfy OpenSearch complexity rules (upper/lower/digit/symbol, 8+ chars)
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Change-me-0penSearch!
OPENSEARCH_PORT=9200

# ── Grafana (optional dashboards profile) ───────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3001

# ── Sandbox probe target ────────────────────────────────────
JUICESHOP_PORT=3002

# ── API ─────────────────────────────────────────────────────
API_PORT=8000
ENV=dev
# JWT signing secret — generate your own: openssl rand -hex 32
API_SECRET_KEY=change-me-generate-a-long-random-secret

# Admin bootstrap: username/password default to admin/admin in dev.
# In production set ENV=prod and provide ADMIN_PASSWORD or ADMIN_PASSWORD_HASH —
# the API refuses to start prod with the default password.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ── Scanner safety rails ────────────────────────────────────
MAX_SCAN_DURATION_SECONDS=300
MAX_REQUESTS_PER_SECOND=5
BLOCK_PRIVATE_IPS=true
REQUIRE_DOMAIN_VERIFICATION=true

# ── AI enrichment (optional — works fine disabled) ──────────
AI_ENABLED=false
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ── ML risk model (optional) ────────────────────────────────
RISK_MODEL_ENABLED=false
RISK_MODEL_ARTIFACT_PATH=/app/models/risk_model.joblib

# ── GitHub posture connector (optional) ─────────────────────
# Read-only fine-grained PAT for scanning your GitHub org/account.
GITHUB_TOKEN=
