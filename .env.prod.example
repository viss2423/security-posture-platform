# SecPlat PRODUCTION environment.
#
# On your server:  cp .env.prod.example .env  then fill in every value below.
# Generate secrets with:  openssl rand -hex 32
#
# NEVER commit the filled-in .env. Everything here must be changed from the
# dev defaults before you expose SecPlat to anyone. See SECURITY.md.

# ── Runtime mode ────────────────────────────────────────────
# prod makes the API refuse to start on the default admin password.
ENV=prod

# ── Public hostname + TLS (Caddy) ───────────────────────────
# A domain/subdomain pointed at this server's public IP (e.g. app.example.com).
# Caddy gets a free Let's Encrypt certificate for it automatically.
SECPLAT_DOMAIN=app.example.com
# Email for Let's Encrypt (expiry notices). Optional but recommended.
ACME_EMAIL=you@example.com

# ── Admin bootstrap ─────────────────────────────────────────
ADMIN_USERNAME=admin
# Set a STRONG password (or, better, ADMIN_PASSWORD_HASH — a bcrypt hash).
ADMIN_PASSWORD=change-me-strong-admin-password

# ── API ─────────────────────────────────────────────────────
API_PORT=8000
# JWT signing secret — MUST be unique. Generate: openssl rand -hex 32
API_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Internal service accounts (background workers). Give each a strong value.
SCANNER_SERVICE_PASSWORD=change-me-scanner
INGESTION_SERVICE_PASSWORD=change-me-ingestion
CORRELATOR_SERVICE_PASSWORD=change-me-correlator

# ── Postgres ────────────────────────────────────────────────
POSTGRES_DB=secplat
POSTGRES_USER=secplat
POSTGRES_PASSWORD=change-me-strong-postgres
POSTGRES_PORT=5433
POSTGRES_RUNTIME_USER=secplat_runtime
POSTGRES_RUNTIME_PASSWORD=change-me-strong-runtime

# ── OpenSearch ──────────────────────────────────────────────
OPENSEARCH_HEAP=1g
# Must meet complexity rules (upper/lower/digit/symbol, 8+ chars).
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Change-me-0penSearch!
OPENSEARCH_PORT=9200

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Scanner safety rails (keep these on) ────────────────────
MAX_SCAN_DURATION_SECONDS=300
MAX_REQUESTS_PER_SECOND=5
BLOCK_PRIVATE_IPS=true
REQUIRE_DOMAIN_VERIFICATION=true

# ── Self-service signup ─────────────────────────────────────
# true = anyone can create a read-only demo account (good for a public demo).
# Set to false for a locked-down internal deployment.
ALLOW_SELF_REGISTRATION=true

# ── Optional integrations (leave blank if unused) ───────────
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
AI_ENABLED=false
