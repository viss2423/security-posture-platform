# Oracle VM — environment variables
# Copy to .env and fill in every value before running setup.sh
# Never commit .env to git.

# ── Network ────────────────────────────────────────────────────────────────────
# Public IP of your Oracle ARM VM (find in OCI console → Instances → Public IP)
ORACLE_VM_HOST=1.2.3.4

# ── DefectDojo ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
DEFECTDOJO_DB_PASSWORD=changeme_defectdojo_db
# Generate: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEFECTDOJO_SECRET_KEY=changeme_defectdojo_secret
# Generate: openssl rand -hex 16  (must be exactly 32 hex chars = 16 bytes)
DEFECTDOJO_AES_KEY=changeme_defectdojo_aes_00000

# ── Wazuh ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 24
WAZUH_INDEXER_PASSWORD=changeme_wazuh_indexer
WAZUH_API_PASSWORD=changeme_wazuh_api
WAZUH_DASHBOARD_PASSWORD=changeme_wazuh_dashboard

# ── OpenCTI ────────────────────────────────────────────────────────────────────
OPENCTI_ADMIN_PASSWORD=changeme_opencti_admin
# Generate: python3 -c "import uuid; print(str(uuid.uuid4()))"
OPENCTI_ADMIN_TOKEN=00000000-0000-0000-0000-000000000000

# OpenCTI connector UUIDs — generate one per connector
# python3 -c "import uuid; print(str(uuid.uuid4()))"
MISP_CONNECTOR_ID=00000000-0000-0000-0000-000000000001
CISA_CONNECTOR_ID=00000000-0000-0000-0000-000000000002
ALIENVAULT_CONNECTOR_ID=00000000-0000-0000-0000-000000000003

# AlienVault OTX — free account at otx.alienvault.com → API Key
ALIENVAULT_API_KEY=your_otx_api_key_here

# MISP API key (set after MISP is deployed)
MISP_API_KEY=your_misp_api_key_here

# ── MinIO (OpenCTI file storage) ───────────────────────────────────────────────
# Generate: openssl rand -hex 16
MINIO_ACCESS_KEY=changeme_minio_access
MINIO_SECRET_KEY=changeme_minio_secret_key_32chars

# ── RabbitMQ (OpenCTI message bus) ────────────────────────────────────────────
RABBITMQ_PASSWORD=changeme_rabbitmq

# ── Auth stack ─────────────────────────────────────────────────────────────────
# Shared Postgres password for SuperTokens + Keycloak DBs
AUTH_DB_PASSWORD=changeme_auth_db

# SuperTokens core API key — your app sends this in the st-auth-mode header
# Generate: openssl rand -hex 32
SUPERTOKENS_API_KEY=changeme_supertokens_api_key

# Keycloak bootstrap admin password
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin

# Authelia secrets — all must be ≥32 chars
# Generate each: openssl rand -hex 32
AUTHELIA_JWT_SECRET=changeme_authelia_jwt_secret_minimum_32chars
AUTHELIA_SESSION_SECRET=changeme_authelia_session_secret_32chars
AUTHELIA_STORAGE_KEY=changeme_authelia_storage_key_minimum_32c

# ── Claude AI proxy ────────────────────────────────────────────────────────────
# NVIDIA NIM — free account at build.nvidia.com (40 req/min, no card)
NVIDIA_NIM_API_KEY=nvapi-your-key-here

# OpenRouter — free account at openrouter.ai (29 free models, 200 req/day each, no card)
OPENROUTER_API_KEY=sk-or-your-key-here

# ── Supabase (GitHub Actions keep-alive) ──────────────────────────────────────
# From Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Cloudflare Pages (GitHub Actions deploy) ───────────────────────────────────
# CF_API_TOKEN: Cloudflare dashboard → My Profile → API Tokens → Create Token
#   Use the "Edit Cloudflare Workers" template, scope to your account + Pages
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id
# URL of your backend API (Oracle VM or wherever your FastAPI runs)
CF_API_URL=http://1.2.3.4:8000
