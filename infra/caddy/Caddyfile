# Caddy reverse proxy for SecPlat (production).
#
# Caddy automatically obtains and renews a free Let's Encrypt TLS certificate
# for $SECPLAT_DOMAIN, then proxies all traffic to the frontend container.
# The browser only ever talks to the frontend; the frontend proxies /api/*
# to the API server-side, so the API and datastores stay internal.

{
	# Email used for Let's Encrypt account / expiry notices (optional but recommended).
	email {$ACME_EMAIL}
}

{$SECPLAT_DOMAIN} {
	encode zstd gzip

	# Sensible security headers for a public app.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy frontend:3000
}
